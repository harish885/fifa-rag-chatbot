# Copy to .env and fill in. .env is git-ignored — never commit a real key.

# Required for answer generation (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the Groq model (default: llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# Optional retrieval configuration (defaults shown):
# RAG_TOP_K=5
# RAG_CANDIDATE_POOL=30
# RAG_EXPAND_QUERY=true
# RAG_DEDUPLICATE_PAGES=true
