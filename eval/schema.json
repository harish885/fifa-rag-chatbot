{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Laws-of-the-Game evaluation dataset",
  "type": "object",
  "required": ["name", "role", "items"],
  "properties": {
    "name": {"type": "string", "description": "Dataset identifier, e.g. laws_dev_v1."},
    "role": {"type": "string", "enum": ["development", "held-out", "smoke"],
              "description": "development = used to tune retrieval (optimistic); held-out = frozen, never used to edit rules."},
    "created_by": {"type": "string"},
    "notes": {"type": "string"},
    "page_label_basis": {"type": "string"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "gold_pages"],
        "properties": {
          "question": {"type": "string", "minLength": 1},
          "gold_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1},
          "annotator": {"type": "string"},
          "second_annotator": {"type": "string"},
          "label_agreement": {"type": "string", "enum": ["agree", "disagree", "resolved"]}
        }
      }
    }
  }
}
